# =====================================================================
# AI Coding Mentor - Environment Configuration Template
# =====================================================================
# Copy this file to .env and adjust variables as needed for local execution.
# NEVER commit real credentials, passwords, or production secrets to Git.

# --- Application Environment ---
ENVIRONMENT=development
PORT=8080

# --- Database (MySQL) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ai_coding_mentor
DB_USER=root
DB_PASSWORD=root
DB_URL=jdbc:mysql://localhost:3306/ai_coding_mentor?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

# --- Cache & Queues (Redis - Local or Cloud like Upstash / Render / Redis Cloud) ---
# For Cloud Redis (e.g. Upstash: rediss://default:password@endpoint.upstash.io:6379 or Render Redis):
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_USERNAME=
REDIS_SSL_ENABLED=false
REDIS_TIMEOUT_MS=2000

# --- Asynchronous Messaging (Apache Kafka - Local or Cloud like Upstash / Confluent) ---
KAFKA_ENABLED=true
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=PLAIN
KAFKA_SASL_JAAS_CONFIG=

# --- AI Mentor (Ollama Local Instance or Free Cloud LLM via Groq) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:latest
OLLAMA_TIMEOUT_SECONDS=60

# --- Free Cloud AI Alternative (Groq Cloud / OpenRouter - 0 Local Disk Space Needed) ---
# Get your 100% free lifetime key at https://console.groq.com (no credit card needed)
GROQ_API_KEY=your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile
AI_TIMEOUT_SECONDS=30

# --- Security & JWT ---
JWT_SECRET=developmentSecretKeyChangeMeForProductionUseOnlyAtLeast256BitsLong12345
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# --- Google OAuth 2.0 (Google Identity Services) ---
# Create web client ID at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# --- Code Execution Sandbox ---
EXECUTION_WORKER_TIMEOUT_SECONDS=5
EXECUTION_MAX_MEMORY_MB=256
EXECUTION_MAX_CPU=1.0

# --- Cloud Production Email Service (Brevo HTTPS REST API - Never blocked by Render) ---
# Get free API key at https://app.brevo.com/settings/keys/api (300 emails/day free)
BREVO_API_KEY=your_brevo_api_key_here

# --- Google SMTP Email Notifications (Local Development & Fallback) ---
# Generate 16-character App Password at: Google Account -> Security -> 2-Step Verification -> App Passwords
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_16_char_google_app_password
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=465
APP_MAIL_FROM=CodingFriend <your_email@gmail.com>
APP_FRONTEND_URL=https://codingfriend.vercel.app
MAIL_ENABLED=true


# --- Frontend Client ---
VITE_API_BASE_URL=http://localhost:8080/api/v1

