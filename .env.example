# =====================================================================
# AI Coding Mentor - Environment Configuration Template
# =====================================================================
# Copy this file to .env and adjust variables as needed for local execution.
# NEVER commit real credentials, passwords, or production secrets to Git.

# --- Application Environment ---
ENVIRONMENT=development
PORT=8080

# --- Database (PostgreSQL) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ai_coding_mentor
DB_USER=postgres
DB_PASSWORD=postgres
DB_URL=jdbc:postgresql://localhost:5432/ai_coding_mentor

# --- Cache & Queues (Redis) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Asynchronous Messaging (Apache Kafka) ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- AI Mentor (Ollama Local Instance) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:latest
OLLAMA_TIMEOUT_SECONDS=60

# --- Security & JWT ---
JWT_SECRET=developmentSecretKeyChangeMeForProductionUseOnlyAtLeast256BitsLong12345
JWT_EXPIRATION_MS=86400000

# --- Code Execution Sandbox ---
EXECUTION_WORKER_TIMEOUT_SECONDS=5
EXECUTION_MAX_MEMORY_MB=256
EXECUTION_MAX_CPU=1.0

# --- Frontend Client ---
VITE_API_BASE_URL=http://localhost:8080/api/v1
